cat >> .gitignore << 'EOF'

# Visual Studio Code
.vscode/
*.code-workspace

# Configuración de desarrollo (puede contener secrets)
appsettings.Development.json

# Archivos de usuario
*.user
*.suo

# Carpetas de base de datos local
**/moviesdb/
*.db
*.sqlite
*.mdf
*.ldf

# Visual Studio
.vs/
.env

# Rider
.idea/

# macOS
.DS_Store


EOF